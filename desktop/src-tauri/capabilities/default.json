{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Desktop window can spawn only the bundled ai-config RPC sidecar.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "shell:allow-stdin-write",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/ai-config-rpc",
          "sidecar": true,
          "args": false
        }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
